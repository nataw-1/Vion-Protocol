# N VION Protocol — Nataw_bot Environment Config
# Phase 1 — Off-Chain / Local Machine
# Copy this to .env and fill in your values. Never commit .env to version control.

# ─── OWNER AUTH ───────────────────────────────────────────────────────────────
# The AUTH token the Owner uses to issue OWNER_COMMANDs.
# Generate a strong random secret. Rotate after every HALT event.
VION_AUTH_TOKEN=your_secret_auth_token_here

# ─── TELEGRAM ─────────────────────────────────────────────────────────────────
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram chat ID — where ESCALATE/HALT alerts are sent
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─── PATHS ────────────────────────────────────────────────────────────────────
# Paths to the constitutional documents
SOUL_MD_PATH=./constitution/VION.md
IDENTITY_MD_PATH=./constitution/IDENTITY.md

# Path to the activity log
LOG_PATH=./logs/activity.log

# ─── SYSTEM ───────────────────────────────────────────────────────────────────
# Deployment name — identifies this deployment in logs
DEPLOYMENT_NAME=N-Nexus-Reference

# Session timeout in seconds (commands older than this are rejected)
COMMAND_EXPIRY_SECONDS=300

# Dry run mode — TRUE enforces dry-run globally, FALSE allows LIVE override
DRY_RUN_DEFAULT=TRUE
